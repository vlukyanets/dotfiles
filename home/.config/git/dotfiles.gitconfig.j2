# Managed by dotfiles (features.git) — edit
# home/.config/git/dotfiles.gitconfig.j2 in the repo, not this file.
# Included from the top of ~/.config/git/config: what follows it there overrides this.
{% if git.name or git.email %}
[user]
{% if git.name %}
	name = "{{ git.name }}"
{% endif %}
{% if git.email %}
	email = {{ git.email }}
{% endif %}
{% endif %}
