# Read by the go command itself (see `go help environment`, GOENV), so it
# holds regardless of shell — hosts here don't necessarily manage .zshrc.
# Keeps Go's tree out of $HOME/go: GOMODCACHE follows GOPATH
# (<GOPATH>/pkg/mod), and `go install` binaries land next to everything
# else in ~/.local/bin, which is on PATH. `go env -w` rewrites this file
# and drops the comments — changes go in the chezmoi source instead.
GOPATH={{ home }}/.local/share/go
GOBIN={{ home }}/.local/bin
