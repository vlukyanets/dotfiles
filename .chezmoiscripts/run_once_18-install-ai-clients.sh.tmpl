#!/usr/bin/env bash
{{ if and (not .ai.clients.claude_desktop) (not .ai.clients.claude_code) -}}
echo "==> AI clients installation skipped (all disabled in config)."
exit 0
{{- end }}

set -euo pipefail

if ! command -v paru &>/dev/null; then
    echo "ERROR: paru is required for AI clients (AUR packages) but not found."
    exit 1
fi

echo "==> Installing AI clients..."

packages=(
{{- if .ai.clients.claude_desktop }}
    claude-desktop
{{- end }}
{{- if .ai.clients.claude_code }}
    claude-code
{{- end }}
)

paru -S --needed --noconfirm "${packages[@]}"

echo "==> AI clients installed."
