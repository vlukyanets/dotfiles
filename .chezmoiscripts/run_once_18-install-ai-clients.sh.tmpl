#!/usr/bin/env bash
{{ if and (not .ai.clients.lmstudio) (not .ai.clients.claude) -}}
echo "==> AI clients installation skipped (all disabled in config)."
exit 0
{{- end }}

set -euo pipefail

if ! command -v paru &>/dev/null; then
    echo "ERROR: paru is required for AI clients (AUR packages) but not found."
    exit 1
fi

echo "==> Installing AI clients..."

packages=(
{{- if .ai.clients.lmstudio }}
    lmstudio-bin
{{- end }}
{{- if .ai.clients.claude }}
    claude-desktop-bin
{{- end }}
)

paru -S --needed --noconfirm "${packages[@]}"

{{- if .ai.clients.lmstudio }}

echo "==> Installing LM Studio CLI (lms)..."
curl -fsSL https://lmstudio.ai/install.sh | bash

{{- end }}

echo "==> AI clients installed."
