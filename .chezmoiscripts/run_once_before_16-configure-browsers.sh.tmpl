#!/bin/sh

set -eu

SUDO_CMD="${SUDO_CMD:-sudo}"

{{- if not .browsers }}

echo "==> Skipping browser install (browsers is empty for this host)"
exit 0
{{- end }}

{{- range $name, $browser := .browsers }}
{{- if not $browser.enabled }}

echo "==> Skipping {{ $name }} (browsers.{{ $name }}.enabled is false)"
{{- else }}
{{-   if eq $browser.source "aur" }}
{{-     if not $.pkg_mgmt.aur.enabled }}

echo "==> browsers.{{ $name }}.source is \"aur\", but pkg_mgmt.aur.enabled is false for this host — enable it first" >&2
exit 1
{{-     end }}

echo "==> Installing {{ $name }} via paru ({{ join " " $browser.packages }})"
paru -S --needed --noconfirm {{ join " " $browser.packages }}
{{-   else if eq $browser.source "pacman" }}

echo "==> Installing {{ $name }} ({{ join " " $browser.packages }})"
$SUDO_CMD pacman -S --needed --noconfirm {{ join " " $browser.packages }}
{{-   else }}

echo "==> Unknown browsers.{{ $name }}.source '{{ $browser.source }}' — supported values: \"pacman\", \"aur\"" >&2
exit 1
{{-   end }}

{{- if $browser.settings }}
{{-   $prefLines := list }}
{{-   range $pref, $value := $browser.settings }}
{{-     $prefLines = append $prefLines (printf "      %s: { \"Value\": %s, \"Status\": \"default\" }" ($pref | toJson) ($value | toJson)) }}
{{-   end }}

echo "==> Writing {{ $name }} about:config defaults"
POLICIES_DIR="/usr/lib/{{ first $browser.packages }}/distribution"
$SUDO_CMD mkdir -p "$POLICIES_DIR"
$SUDO_CMD tee "$POLICIES_DIR/policies.json" >/dev/null <<JSON
{
  "policies": {
    "Preferences": {
{{ join ",\n" $prefLines }}
    }
  }
}
JSON
{{- else }}

echo "==> No settings configured for {{ $name }}, skipping policies.json"
{{- end }}
{{- end }}
{{- end }}
