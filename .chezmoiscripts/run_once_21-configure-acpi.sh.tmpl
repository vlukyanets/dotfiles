#!/usr/bin/env bash

set -euo pipefail

# ── Packages ──────────────────────────────────────────────────────────────────
echo "==> Installing ACPI and power-management packages..."
sudo pacman -S --needed --noconfirm acpid swayidle power-profiles-daemon

# ── System services ───────────────────────────────────────────────────────────
sudo systemctl enable --now acpid.service
sudo systemctl enable --now power-profiles-daemon.service

# ── Lid-switch handler ────────────────────────────────────────────────────────
# lid.sh exits early when no niri session is found, so it is safe on all hosts
echo "==> Deploying ACPI lid-switch handler..."
sudo mkdir -p /etc/acpi/events
sudo cp "{{ .chezmoi.sourceDir }}/system/etc/acpi/events/lid" /etc/acpi/events/lid
sudo chmod 644 /etc/acpi/events/lid
sudo cp "{{ .chezmoi.sourceDir }}/system/etc/acpi/lid.sh" /etc/acpi/lid.sh
sudo chmod 755 /etc/acpi/lid.sh
sudo chown -R root:root /etc/acpi/events /etc/acpi/lid.sh

# ── logind.conf — delegate lid events to acpid ───────────────────────────────
echo "==> Patching logind.conf (HandleLidSwitch=ignore)..."
sudo sed -i 's/^#\?HandleLidSwitch=.*/HandleLidSwitch=ignore/' /etc/systemd/logind.conf
sudo sed -i 's/^#\?HandleLidSwitchExternalPower=.*/HandleLidSwitchExternalPower=ignore/' /etc/systemd/logind.conf
echo "    logind config changed — a reboot is required for it to take effect"

# ── Power-profile udev rules & switch script ─────────────────────────────────
echo "==> Installing power-profile udev rules and switch script..."
sudo mkdir -p /etc/udev/rules.d
sudo cp "{{ .chezmoi.sourceDir }}/system/etc/udev/rules.d/99-power-profile.rules" /etc/udev/rules.d/99-power-profile.rules
sudo chown root:root /etc/udev/rules.d/99-power-profile.rules
sudo chmod 644 /etc/udev/rules.d/99-power-profile.rules
sudo udevadm control --reload-rules

sudo cp "{{ .chezmoi.sourceDir }}/system/usr/local/bin/power-profile-switch.sh" /usr/local/bin/power-profile-switch.sh
sudo chown root:root /usr/local/bin/power-profile-switch.sh
sudo chmod 755 /usr/local/bin/power-profile-switch.sh

# ── Kernel parameters for reliable ACPI power-off ────────────────────────────
# acpi=force     — forces ACPI even when the BIOS doesn't fully advertise it
# acpi_osi=Linux — tells the BIOS firmware it's running Linux (some boards
#                  behave differently and expose S5 power-off only with this)

PARAMS="acpi=force acpi_osi=Linux"
echo "==> WARNING: Add the following parameters to your kernel command line manually:"
echo "    ${PARAMS}"

echo "==> ACPI configuration complete."

