#!/bin/sh

set -eu

SUDO_CMD="${SUDO_CMD:-sudo}"

{{- if not .office }}

echo "==> Skipping office package install (office is empty for this host)"
exit 0
{{- end }}

{{- range $name, $app := .office }}
{{- if $app.enabled }}
{{-   if eq $app.source "aur" }}
{{-     if not $.pkg_mgmt.aur.enabled }}

echo "==> office.{{ $name }}.source is \"aur\", but pkg_mgmt.aur.enabled is false for this host — enable it first" >&2
exit 1
{{-     end }}

echo "==> Installing {{ $name }} via paru ({{ join " " $app.packages }})"
paru -S --needed --noconfirm {{ join " " $app.packages }}
{{-   else if eq $app.source "pacman" }}

echo "==> Installing {{ $name }} ({{ join " " $app.packages }})"
$SUDO_CMD pacman -S --needed --noconfirm {{ join " " $app.packages }}
{{-   else }}

echo "==> Unknown office.{{ $name }}.source '{{ $app.source }}' — supported values: \"pacman\", \"aur\"" >&2
exit 1
{{-   end }}
{{- end }}
{{- end }}
