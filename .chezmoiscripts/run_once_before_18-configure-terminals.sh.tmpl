#!/bin/sh

set -eu

SUDO_CMD="${SUDO_CMD:-sudo}"

{{- if not .terminals }}

echo "==> Skipping terminal install (terminals is empty for this host)"
exit 0
{{- end }}

{{- range $name, $terminal := .terminals }}
{{- if $terminal.enabled }}

echo "==> Installing {{ $name }} ({{ join " " $terminal.packages }})"
$SUDO_CMD pacman -S --needed --noconfirm {{ join " " $terminal.packages }}
{{- end }}
{{- end }}
