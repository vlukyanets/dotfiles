#!/usr/bin/env bash
{{ if not .advanced_tools_enabled -}}
echo "==> Advanced tools installation skipped (disabled in config)."
exit 0
{{- end }}

set -euo pipefail

echo "==> Installing advanced tools..."

sudo pacman -S --needed --noconfirm \
    curl \
    wget \
    eza \
    fd \
    fzf \
    ncdu \
    duf \
    btop \
    htop \
    jq \
    yq \
    rsync \
    tree \
    tmux \
    zellij \
    neovim \
    just \
    fastfetch \
    ripgrep \
    unzip \
    zip \
    zoxide

echo "==> Advanced tools installed."
