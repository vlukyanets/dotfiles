#!/usr/bin/env bash
{{ if not .draind_enabled -}}
echo "==> draind installation skipped (disabled in config)."
exit 0
{{- end }}
{{ if not .paru_enabled -}}
echo "==> draind installation skipped (paru disabled)."
exit 0
{{- end }}

set -euo pipefail

echo "==> Installing draind power manager..."

if ! command -v paru &>/dev/null; then
    echo "ERROR: paru is required for AUR packages but not found."
    exit 1
fi

paru -S --needed --noconfirm draind

echo "==> Enabling draind services..."

sudo systemctl enable draind.service
systemctl --user enable draind-agent.service

echo "==> draind installed."
