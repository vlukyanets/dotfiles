#!/usr/bin/env bash
{{ if not .dev_tools_enabled -}}
echo "==> Development tools installation skipped (disabled in config)."
exit 0
{{- end }}

set -euo pipefail

echo "==> Installing development tools..."

sudo pacman -S --needed --noconfirm \
    base-devel \
    gcc \
    clang \
    gdb \
    lldb \
    llvm \
    python \
    python-pip \
    nodejs \
    npm \
    rustup \
    dotnet-sdk \
    go \
    ninja \
    meson \
    cmake \
    just

echo "==> Setting up Rust stable toolchain..."

rustup default stable

{{ if .paru_enabled -}}
echo "==> Installing AUR development tools..."

if ! command -v paru &>/dev/null; then
    echo "ERROR: paru is required for AUR packages but not found."
    exit 1
fi

paru -S --needed --noconfirm visual-studio-code-bin

{{- else -}}
echo "==> Skipping AUR development tools (paru disabled): visual-studio-code-bin"
{{- end }}

echo "==> Development tools installed."
