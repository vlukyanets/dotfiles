#!/bin/sh

set -eu

SUDO_CMD="${SUDO_CMD:-sudo}"

{{- if not .password_managers }}

echo "==> Skipping password manager install (password_managers is empty for this host)"
exit 0
{{- end }}

{{- range $name, $manager := .password_managers }}
{{- if $manager.enabled }}
{{-   if eq $manager.source "aur" }}
{{-     if not $.pkg_mgmt.aur.enabled }}

echo "==> password_managers.{{ $name }}.source is \"aur\", but pkg_mgmt.aur.enabled is false for this host — enable it first" >&2
exit 1
{{-     end }}

echo "==> Installing {{ $name }} via paru ({{ join " " $manager.packages }})"
paru -S --needed --noconfirm {{ join " " $manager.packages }}
{{-   else if eq $manager.source "pacman" }}

echo "==> Installing {{ $name }} ({{ join " " $manager.packages }})"
$SUDO_CMD pacman -S --needed --noconfirm {{ join " " $manager.packages }}
{{-   else }}

echo "==> Unknown password_managers.{{ $name }}.source '{{ $manager.source }}' — supported values: \"pacman\", \"aur\"" >&2
exit 1
{{-   end }}
{{- end }}
{{- end }}
