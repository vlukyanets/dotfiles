#!/usr/bin/env bash
{{ if not .base_tools_enabled -}}
echo "==> Base tools installation skipped (disabled in config)."
exit 0
{{- end }}

set -euo pipefail

echo "==> Installing base tools..."

sudo pacman -S --needed --noconfirm \
    curl \
    wget \
    fzf \
    htop \
    iotop \
    jq \
    yq \
    rsync \
    tree \
    tmux \
    unzip \
    zip \
    7zip

echo "==> Base tools installed."
