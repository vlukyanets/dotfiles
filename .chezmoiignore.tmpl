# Repo files, not dotfiles: chezmoi treats every non-dot name in the source
# as a target, so without this they'd land in $HOME.
README.md
LICENSE
CLAUDE.md
docs
system

{{- if not .shell.zsh.enabled }}
.zshrc
{{- end }}

{{- if not .shell.zsh.oh_my_zsh.enabled }}
.p10k.zsh
{{- end }}

{{- $kittyTerminal := get .terminals "kitty" | default dict }}
{{- if not (get $kittyTerminal "enabled" | default false) }}
.config/kitty
{{- end }}

{{- $rbwManager := get .password_managers "rbw" | default dict }}
{{- if not (get $rbwManager "enabled" | default false) }}
.config/rbw
{{- end }}

{{- if not (and .desktop.enabled (eq .desktop.environment "niri")) }}
.config/niri
{{- end }}

{{- if not .fcitx5.enabled }}
.config/fcitx5
.local/share/fcitx5
{{- end }}

{{- if not (eq .desktop.niri.shell "noctalia") }}
.local/state/noctalia
{{- end }}

{{- $ghDev := get .development "gh" | default dict }}
{{- if not (get $ghDev "enabled" | default false) }}
.config/gh
{{- end }}

{{- $vscodeIde := get .ide "vscode" | default dict }}
{{- if not (get $vscodeIde "enabled" | default false) }}
.config/Code
