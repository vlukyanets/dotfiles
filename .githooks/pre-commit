#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"

mapfile -d '' age_files < <(git -C "$REPO_ROOT" ls-files -z '*.age')
[ ${#age_files[@]} -gt 0 ] || exit 0

AGE="${AGE_CMD:-age}"
if ! command -v "$AGE" &>/dev/null; then
    echo "pre-commit: $AGE not found — cannot re-encrypt (set AGE_CMD to override)" >&2
    exit 1
fi

count=0
for aged in "${age_files[@]}"; do
    plain="${REPO_ROOT}/${aged%.age}"
    aged_full="${REPO_ROOT}/$aged"
    [ -f "$plain" ] || continue
    if [ "$plain" -nt "$aged_full" ]; then
        "$AGE" -R "$REPO_ROOT/.age-recipients" -o "$aged_full" "$plain"
        git -C "$REPO_ROOT" add "$aged"
        echo "pre-commit: re-encrypted ${aged%.age} → $aged"
        (( count++ )) || true
    fi
done
echo "pre-commit: $count file(s) re-encrypted"
