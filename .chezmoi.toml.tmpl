{{- $hostname := .chezmoi.hostname -}}
{{- $identity := env "AGE_IDENTITY" | default (joinPath .chezmoi.homeDir ".ssh/id_ed25519") -}}

{{- $paru            := false -}}
{{- $nvidia          := false -}}
{{- $zsh             := false -}}
{{- $multilibEnabled := false -}}
{{- $parallel        := 1 -}}
{{- $baseTools       := false -}}
{{- $advancedTools   := false -}}
{{- $niri            := false -}}
{{- $reflectorCountries   := "" -}}
{{- $reflectorSort        := "age" -}}
{{- $reflectorServers     := 5 -}}

{{- if stat (joinPath .chezmoi.sourceDir ".chezmoidata.toml") -}}
{{-   $allHosts := fromToml (include ".chezmoidata.toml") -}}
{{-   if hasKey $allHosts $hostname -}}
{{-     $cfg             := get $allHosts $hostname -}}
{{-     $paru             = get $cfg "paru" -}}
{{-     $nvidia           = get $cfg "nvidia" -}}
{{-     $zsh              = get $cfg "zsh" | default false -}}
{{-     $pacman          := get $cfg "pacman" | default dict -}}
{{-     $multilibEnabled  = get $pacman "multilib_enabled" | default false -}}
{{-     $parallel         = get $pacman "parallel" | default 1 -}}
{{-     $baseTools        = get $cfg "base_tools_enabled"    | default false -}}
{{-     $advancedTools    = get $cfg "advanced_tools_enabled" | default false -}}
{{-     $niri             = get $cfg "niri_enabled" | default false -}}
{{-     $reflector            := get $cfg "reflector" | default dict -}}
{{-     $reflectorCountries    = get $reflector "countries" | default "" -}}
{{-     $reflectorSort         = get $reflector "sort"      | default "age" -}}
{{-     $reflectorServers      = get $reflector "servers"   | default 5 -}}
{{-   end -}}
{{- else -}}
{{-   $paru            = promptBoolOnce . "paru_enabled"            "Enable paru AUR helper installation" -}}
{{-   $nvidia          = promptBoolOnce . "nvidia_enabled"          "Enable NVIDIA driver installation" -}}
{{-   $zsh             = promptBoolOnce . "zsh_enabled"             "Enable zsh + oh-my-zsh + powerlevel10k installation" -}}
{{-   $multilibEnabled = promptBoolOnce . "pacman_multilib_enabled" "Enable pacman multilib repository" -}}
{{-   $parallel        = promptIntOnce  . "pacman_parallel"         "Pacman parallel downloads count" -}}
{{-   $baseTools       = promptBoolOnce . "base_tools_enabled"      "Install base CLI tools (eza, fzf, htop, tmux…)" -}}
{{-   $advancedTools   = promptBoolOnce . "advanced_tools_enabled"  "Install advanced tools (neovim, zellij, ripgrep…)" -}}
{{-   $niri            = promptBoolOnce   . "niri_enabled"            "Install niri Wayland compositor and desktop environment" -}}
{{-   $reflectorCountries   = promptStringOnce . "reflector_countries"    "Reflector mirror countries (comma-separated, empty for no filter)" -}}
{{-   $reflectorSort        = promptStringOnce . "reflector_sort"         "Reflector sort method (age, rate, country, score, delay)" -}}
{{-   $reflectorServers     = promptIntOnce    . "reflector_servers"      "Number of reflector mirrors to select" -}}
{{- end -}}

encryption = "age"

[age]
    command        = "{{ env "AGE_CMD" | default "age" }}"
    identity       = "{{ $identity }}"
    recipientsFile = "{{ .chezmoi.sourceDir }}/.age-recipients"

[data]
    paru_enabled           = {{ $paru }}
    nvidia_enabled         = {{ $nvidia }}
    zsh_enabled            = {{ $zsh }}
    base_tools_enabled     = {{ $baseTools }}
    advanced_tools_enabled = {{ $advancedTools }}
    niri_enabled           = {{ $niri }}

[data.pacman]
    multilib_enabled = {{ $multilibEnabled }}
    parallel         = {{ $parallel }}

[data.reflector]
    countries = "{{ $reflectorCountries }}"
    sort      = "{{ $reflectorSort }}"
    servers   = {{ $reflectorServers }}
