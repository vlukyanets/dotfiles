{{- $hostname := .chezmoi.hostname -}}
{{- $identity := env "AGE_IDENTITY" | default (joinPath .chezmoi.homeDir ".ssh/id_ed25519") -}}

{{- $paru               := false -}}
{{- $nvidia             := false -}}
{{- $zsh                := false -}}
{{- $multilibEnabled    := false -}}
{{- $parallel           := 1 -}}
{{- $baseTools          := false -}}
{{- $advancedTools      := false -}}
{{- $niri               := false -}}
{{- $libvirt            := false -}}
{{- $devTools           := false -}}
{{- $rbw                := false -}}
{{- $yubikey            := false -}}
{{- $tailscale          := false -}}
{{- $aiLmstudio         := false -}}
{{- $aiClaude           := false -}}
{{- $languages          := list "english" -}}
{{- $useFcitx5          := false -}}
{{- $reflectorCountries := "" -}}
{{- $reflectorSort      := "age" -}}
{{- $reflectorServers   := 5 -}}

{{- if stat (joinPath .chezmoi.sourceDir ".chezmoidata.toml") -}}
{{-   $allHosts := fromToml (include ".chezmoidata.toml") -}}
{{-   if hasKey $allHosts $hostname -}}
{{-     $cfg            := get $allHosts $hostname -}}
{{-     $paru            = get $cfg "paru_enabled"            | default false -}}
{{-     $nvidia          = get $cfg "nvidia_enabled"          | default false -}}
{{-     $zsh             = get $cfg "zsh_enabled"             | default false -}}
{{-     $pacman         := get $cfg "pacman"          | default dict -}}
{{-     $multilibEnabled = get $pacman "multilib_enabled"     | default false -}}
{{-     $parallel        = get $pacman "parallel"             | default 1 -}}
{{-     $baseTools       = get $cfg "base_tools_enabled"      | default false -}}
{{-     $advancedTools   = get $cfg "advanced_tools_enabled"  | default false -}}
{{-     $niri            = get $cfg "niri_enabled"            | default false -}}
{{-     $libvirt         = get $cfg "libvirt_enabled"         | default false -}}
{{-     $devTools        = get $cfg "dev_tools_enabled"       | default false -}}
{{-     $rbw             = get $cfg "rbw_enabled"             | default false -}}
{{-     $yubikey         = get $cfg "yubikey_enabled"         | default false -}}
{{-     $tailscale       = get $cfg "tailscale_enabled"       | default false -}}
{{-     $ai             := get $cfg "ai"              | default dict -}}
{{-     $aiClients      := get $ai  "clients"         | default dict -}}
{{-     $aiLmstudio      = get $aiClients "lmstudio"  | default false -}}
{{-     $aiClaude        = get $aiClients "claude"    | default false -}}
{{-     $languages       = get $cfg "languages"       | default (list "english") -}}
{{-     $useFcitx5       = get $cfg "use_fcitx5"      | default false -}}
{{-     $reflector      := get $cfg "reflector"       | default dict -}}
{{-     $reflectorCountries = get $reflector "countries" | default "" -}}
{{-     $reflectorSort      = get $reflector "sort"      | default "age" -}}
{{-     $reflectorServers   = get $reflector "servers"   | default 5 -}}
{{-   end -}}
{{- else -}}
{{-   $paru            = promptBoolOnce   . "paru_enabled"            "Enable paru AUR helper installation" -}}
{{-   $nvidia          = promptBoolOnce   . "nvidia_enabled"          "Enable NVIDIA driver installation" -}}
{{-   $zsh             = promptBoolOnce   . "zsh_enabled"             "Enable zsh + oh-my-zsh + powerlevel10k installation" -}}
{{-   $multilibEnabled = promptBoolOnce   . "pacman_multilib_enabled" "Enable pacman multilib repository" -}}
{{-   $parallel        = promptIntOnce    . "pacman_parallel"         "Pacman parallel downloads count" -}}
{{-   $baseTools       = promptBoolOnce   . "base_tools_enabled"      "Install base CLI tools (eza, fzf, htop, tmux…)" -}}
{{-   $advancedTools   = promptBoolOnce   . "advanced_tools_enabled"  "Install advanced tools (neovim, zellij, ripgrep…)" -}}
{{-   $niri            = promptBoolOnce   . "niri_enabled"            "Install niri Wayland compositor and desktop environment" -}}
{{-   $libvirt         = promptBoolOnce   . "libvirt_enabled"         "Install libvirt/QEMU virtualization stack" -}}
{{-   $devTools        = promptBoolOnce   . "dev_tools_enabled"       "Install development tools (gcc, clang, python, node, rust, go…)" -}}
{{-   $rbw             = promptBoolOnce   . "rbw_enabled"             "Install rbw (Bitwarden CLI)" -}}
{{-   $yubikey         = promptBoolOnce   . "yubikey_enabled"         "Install YubiKey tools and udev rules" -}}
{{-   $tailscale       = promptBoolOnce   . "tailscale_enabled"       "Install Tailscale and enable tailscaled service" -}}
{{-   $aiLmstudio      = promptBoolOnce   . "ai_lmstudio"             "Install LM Studio (AI model runner)" -}}
{{-   $aiClaude        = promptBoolOnce   . "ai_claude"               "Install Claude desktop client" -}}
{{-   $languagesStr   := promptStringOnce . "languages"               "Enabled keyboard layouts (comma-separated: english,russian,ukrainian,chinese)" -}}
{{-   $languages       = splitList "," $languagesStr -}}
{{-   $useFcitx5       = promptBoolOnce   . "use_fcitx5"              "Install and enable fcitx5 input method framework" -}}
{{-   $reflectorCountries = promptStringOnce . "reflector_countries"  "Reflector mirror countries (comma-separated, empty for no filter)" -}}
{{-   $reflectorSort      = promptStringOnce . "reflector_sort"       "Reflector sort method (age, rate, country, score, delay)" -}}
{{-   $reflectorServers   = promptIntOnce    . "reflector_servers"    "Number of reflector mirrors to select" -}}
{{- end -}}

encryption = "age"

[age]
    command        = "{{ env "AGE_CMD" | default "age" }}"
    identity       = "{{ $identity }}"

[data]
    paru_enabled           = {{ $paru }}
    nvidia_enabled         = {{ $nvidia }}
    zsh_enabled            = {{ $zsh }}
    base_tools_enabled     = {{ $baseTools }}
    advanced_tools_enabled = {{ $advancedTools }}
    niri_enabled           = {{ $niri }}
    libvirt_enabled        = {{ $libvirt }}
    dev_tools_enabled      = {{ $devTools }}
    rbw_enabled            = {{ $rbw }}
    yubikey_enabled        = {{ $yubikey }}
    tailscale_enabled      = {{ $tailscale }}
    languages              = {{ toJson $languages }}
    use_fcitx5             = {{ $useFcitx5 }}

[data.pacman]
    multilib_enabled = {{ $multilibEnabled }}
    parallel         = {{ $parallel }}

[data.ai.clients]
    lmstudio = {{ $aiLmstudio }}
    claude   = {{ $aiClaude }}

[data.reflector]
    countries = "{{ $reflectorCountries }}"
    sort      = "{{ $reflectorSort }}"
    servers   = {{ $reflectorServers }}
